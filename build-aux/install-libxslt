#!/bin/sh
set -e
# 1.1.45 needs libxml2 2.15.1 or later (ubuntu-26.04 runners have it).
VER=1.1.45
SHA256=9acfe68419c4d06a45c550321b3212762d92f41465062ca4ea19e632ee5d216e
wget -q https://download.gnome.org/sources/libxslt/1.1/libxslt-$VER.tar.xz
echo "$SHA256  libxslt-$VER.tar.xz" | sha256sum -c -
tar xfJ libxslt-$VER.tar.xz
cd libxslt-$VER
./configure
make
#make check
sudo make install
